{
  "name": "sommark",
  "displayName": "SomMark",
  "description": "Syntax highlighting and basic language support for SomMark, a minimal, extensible markup language for documentation.",
  "publisher": "AdamElmi",
  "version": "2.0.1",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "1.104.0",
    "typescript": "^4.5.5"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sommark",
        "aliases": [
          "SomMark",
          "sommark"
        ],
        "extensions": [
          ".smark"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sommark-icon.svg",
          "dark": "./icons/sommark-icon.svg"
        }
      }
    ]
  },
  "repository": {
    "url": "https://github.com/Adam-Elmi/SomMark-Vscode"
  },
  "icon": "icons/sommark.png",
  "dependencies": {
    "sommark": "^2.0.2"
  }
}